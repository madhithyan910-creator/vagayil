rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Simplified: Admin username/pass is handled by backend API. 
      // For Firestore rules, we could use a specific UID if known, 
      // but here the server handles admin writes.
      // However, the client might need to read some data.
      return false; // Backend usually bypasses or uses Admin SDK
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Rooms: Read for all, Write for admin (via server)
    match /rooms/{roomId} {
      allow read: if true;
    }

    // Bookings: Create for all, Read for admin (via server)
    match /bookings/{bookingId} {
      allow create: if true;
    }

    // Reviews: Read for all, Create for authenticated users
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete, update: if isOwner(resource.data.userId);
    }

    // Tourist Spots: Read for all
    match /touristSpots/{spotId} {
      allow read: if true;
    }

    // Settings: Read for all
    match /settings/{settingId} {
      allow read: if true;
    }
  }
}
